{
  "name": "glass-start",
  "version": "4.2.0",
  "description": "Glass Start - 现代极简、毛玻璃质感、灵动动画的起始页与分类导航",
  "main": "dist/index.html",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node test/run.mjs",
    "test:fast": "node test/run.mjs --no-build",
    "test:ui": "node test/run.mjs ui --no-build",
    "test:data": "node test/run.mjs data --no-build",
    "test:infra": "node test/run.mjs infra --no-build",
    "test:lifecycle": "node test/run.mjs lifecycle --no-build",
    "test:all": "node test/run.mjs --force",
    "test:visual": "node test/visual-regression.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "dev": "npm run build && node scripts/server.js",
    "watch": "node scripts/build.js --watch",
    "preview": "npm run build && node scripts/server.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3"
  },
  "keywords": [
    "startpage",
    "glassmorphism",
    "tailwind"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true
}
