{
  "name": "glass-start",
  "version": "5.5.4",
  "description": "Glass Start — 极简纯净的毛玻璃浏览器起始页。",
  "main": "dist/index.html",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:deploy": "npm run build && node scripts/retain-deployed.cjs",
    "build:extension": "node scripts/build-extension.cjs",
    "benchmark": "npm run build && node test/benchmark-transition.mjs",
    "test": "node test/run.mjs",
    "test:ui": "node test/run.mjs ui",
    "test:data": "node test/run.mjs data",
    "test:infra": "node test/run.mjs infra",
    "test:lifecycle": "node test/run.mjs lifecycle",
    "test:visual": "node test/visual-regression.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "test:w3c": "node scripts/validate-w3c.mjs",
    "test:icons": "node test/verify-local-icons.mjs",
    "sync:icons": "node scripts/sync-icons.mjs",
    "sync:icons:refresh": "node scripts/sync-icons.mjs --refresh",
    "dev": "node scripts/server.cjs",
    "dev:https": "node scripts/server.cjs --https",
    "preview": "npm run build && node scripts/server.cjs --no-watch",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.sw.json && tsc --project tsconfig.scripts.json",
    "test:unit": "node test/run.mjs --unit"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "@types/node": "^26.6.6",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "stylelint": "^18.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "startpage",
    "glassmorphism",
    "tailwind"
  ],
  "author": "leosdcn",
  "license": "GPL-3.0-or-later",
  "private": true,
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
