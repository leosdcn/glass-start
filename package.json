{
  "name": "glass-start",
  "version": "5.1.0",
  "description": "Glass Start — 极简纯净的毛玻璃浏览器起始页。",
  "main": "dist/index.html",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node test/run.mjs",
    "test:ui": "node test/run.mjs ui",
    "test:data": "node test/run.mjs data",
    "test:infra": "node test/run.mjs infra",
    "test:lifecycle": "node test/run.mjs lifecycle",
    "test:all": "node test/run.mjs",
    "test:visual": "node test/visual-regression.mjs",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "test:w3c": "node scripts/validate-w3c.mjs",
    "test:icons": "node test/verify-local-icons.mjs",
    "sync:icons": "node scripts/sync-icons.mjs",
    "sync:icons:refresh": "node scripts/sync-icons.mjs --refresh",
    "dev": "node scripts/server.js",
    "preview": "npm run build && node scripts/server.js --no-watch",
    "typecheck": "tsc --project tsconfig.json",
    "test:unit": "node --test test/data-pure-models.test.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "startpage",
    "glassmorphism",
    "tailwind"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "overrides": {
    "@parcel/watcher": "2.6.0"
  }
}
